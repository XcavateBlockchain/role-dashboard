# Server-only secrets — never shipped to the browser.
# Alchemy Solana devnet API key; used by the /api/rpc proxy to send transactions.
NUXT_ALCHEMY_API_KEY=
# Optional override of the Alchemy endpoint base (the key is appended).
# NUXT_ALCHEMY_RPC_URL=https://solana-devnet.g.alchemy.com/v2/

# GraphQL endpoint of the realXmarket indexer (all dashboard reads).
NUXT_INDEXER_URL=http://localhost:3010/graphql

# Public runtime config — shipped to the browser.
NUXT_PUBLIC_CLUSTER=devnet
NUXT_PUBLIC_PROGRAM_ID=7TrzjKpdrEhnfhxuw8tWdH1sjxadazscsG5HXCDPLmaY
